{
  "name": "my-app",
  "version": "0.1.0",
  "private": true,
  "workspaces": [
    "apps/*"
  ],
  "scripts": {
    "dev": "turbo run dev --filter=web",
    "build": "turbo run build --filter=web",
    "start": "turbo run start --filter=web",
    "lint": "turbo run lint --filter=web",
    "test": "turbo run test --filter=web"
  },
  "devDependencies": {
    "turbo": "^2.7.5"
  },
  "packageManager": "bun@1.3.14",
  "ignoreScripts": [
    "sharp",
    "unrs-resolver"
  ],
  "trustedDependencies": [
    "sharp",
    "unrs-resolver"
  ]
}
